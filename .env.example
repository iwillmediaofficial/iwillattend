# Copy to .env.local and fill in from Supabase > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Address of the Cloudflare media Worker that stores selfies in R2 (see media-worker/).
# Leave empty to keep selfies in Supabase Storage.
VITE_MEDIA_URL=https://iwill-attend-media.YOUR-SUBDOMAIN.workers.dev
