// Cloudflare hosting for the IWILL Attend website (the built files in dist/).
// Build: npm run build      Deploy: npx wrangler deploy
// The selfie storage Worker is separate: see media-worker/.
{
  "name": "iwill-attend",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    // Every address (/punch, /dashboard, ...) is served by the app's index.html.
    "not_found_handling": "single-page-application"
  }
}
